# =========================================================================
# Secure File Vault - Environment Configuration Template
# =========================================================================

# Server Runtime
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5000

# PostgreSQL Database (Used in Docker and Production)
# For local zero-config SQLite development, use: file:./dev.db
DATABASE_URL=postgresql://vault_admin:SuperSecretVaultDBPassword2026!@localhost:5432/secure_file_vault?schema=public

# Cryptographic Keys (GENERATE SECURE 256-BIT KEYS FOR PRODUCTION USING: openssl rand -hex 32)
SESSION_SECRET=a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef0
MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_SECRET=super_secret_hmac_url_signing_key_987654321_abcdef

# Storage Engine ("local" or "s3")
STORAGE_PROVIDER=local
STORAGE_PATH=./storage_vault

# MinIO / AWS S3 Compatible Object Storage (Required if STORAGE_PROVIDER=s3)
S3_BUCKET=secure-vault-storage
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword2026!
S3_FORCE_PATH_STYLE=true

# Security Quotas & Limits
MAX_FILE_SIZE_BYTES=104857600       # 100 MB per file limit
DEFAULT_STORAGE_QUOTA=524288000     # 500 MB default per user
