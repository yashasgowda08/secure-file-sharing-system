# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN="http://localhost:5173"

# Database Configuration (PostgreSQL for Production, SQLite for dev/test)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/securevault?schema=public"
DATABASE_URL="file:./dev.db"

# Security & Cryptography Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET="replace_with_64_character_secure_random_hex_token"
MASTER_KEY_HEX="replace_with_32_byte_hex_aes_master_key"
HMAC_DOWNLOAD_SECRET="replace_with_secure_random_token_for_expiring_links"

# Object Storage Configuration ("local" or "s3")
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage_vault"

# AWS S3 / MinIO Configuration (Optional if STORAGE_DRIVER=s3)
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="secure-vault-storage"
# AWS_ACCESS_KEY_ID="your_access_key"
# AWS_SECRET_ACCESS_KEY="your_secret_key"
# AWS_ENDPOINT="http://localhost:9000" # for MinIO

# Limits & Quotas
MAX_FILE_SIZE_BYTES=104857600       # 100 MB per file
DEFAULT_USER_QUOTA_BYTES=524288000 # 500 MB per user
